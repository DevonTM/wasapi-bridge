#include <winres.h>
#include "wasapi-bridge.generated.rc.h"
#include "../src/gui/resource.h"
#include "../src/version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#define RT_MANIFEST 24
1 RT_MANIFEST WB_MANIFEST_PATH

IDI_APP_ICON ICON "wasapi-bridge.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    WB_VERSION_MAJOR,WB_VERSION_MINOR,WB_VERSION_PATCH,0
    PRODUCTVERSION WB_VERSION_MAJOR,WB_VERSION_MINOR,WB_VERSION_PATCH,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DevonTM"
            VALUE "FileDescription",  "WASAPI Bridge"
            VALUE "FileVersion",      WB_VERSION
            VALUE "InternalName",     "wasapi-bridge"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "wasapi-bridge.exe"
            VALUE "ProductName",      "WASAPI Bridge"
            VALUE "ProductVersion",   WB_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
